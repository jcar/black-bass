  },
  {
   "id": "daleHump",
   "name": "Dale Creek Hump",
   "x": 2120,
   "y": 2615,
   "tip": "Dense submerged timber on a hump. Slow down and fish the shade.",
   "visible": true
  },
  {
   "id": "bridgeWest",
   "name": "West 515 Bridge",
   "x": 1370,
   "y": 2250,
   "tip": "Pilings and the old roadbed drop into the channel. Best in the fall when the shad move up: run a bladed jig or a squarebill past the pilings.",
