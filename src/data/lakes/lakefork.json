  },
  {
   "id": "glade",
   "name": "Glade Bay",
   "x": 3150,
   "y": 2430,
   "tip": "Spawning flats off the East 515 bridge. Soft plastics around the beds and lily pads.",
   "visible": true
  },
  {
   "id": "bellHump",
   "name": "Bell Hump",
   "x": 2910,
   "y": 1830,
   "tip": "Offshore hump off the Caney channel. Summer ledge fish eat a football jig dragged down the drop, or a drop shot over fish on the sonar.",
