   "visible": true
  },
  {
   "id": "mustangCove",
   "name": "Little Mustang North Cove",
   "x": 520,
   "y": 2900,
   "tip": "The best spawning water in the arm. When it warms, drag a lizard or a fluke across the flats.",
   "visible": true
  },
  {
   "id": "pony",
   "name": "Pony Island",
   "x": 1230,
   "y": 2835,
   "tip": "Grass and timber mid-lake. Walk a topwater early, then grind a squarebill around the edges.",
   "visible": true
  },
  {
   "id": "jigAlley",
   "name": "Little Caney · Jig Alley",
   "x": 1850,
   "y": 2290,
   "tip": "Some of Fork's biggest bass came out of this timber. Pitch a jig tight to the trunks and use heavy line.",
   "visible": true
  },
  {
   "id": "daleHump",
   "name": "Dale Creek Hump",
   "x": 2120,
   "y": 2615,
   "tip": "Dense submerged timber on a hump. Slow down and fish the shade.",
   "visible": true
  },
  {
   "id": "bridgeWest",
   "name": "West 515 Bridge",
   "x": 1370,
   "y": 2250,
   "tip": "Pilings and the old roadbed drop into the channel. Best in the fall when the shad move up.",
   "visible": true
  },
  {
   "id": "glade",
   "name": "Glade Bay",
   "x": 3150,
   "y": 2430,
   "tip": "Spawning flats off the East 515 bridge. Soft plastics around the beds and lily pads.",
   "visible": true
  },
  {
   "id": "bellHump",
   "name": "Bell Hump",
   "x": 2910,
   "y": 1830,
   "tip": "Offshore hump off the Caney channel. Summer ledge fish eat a deep crankbait or a football jig.",
